# Copy to backend/.env for local development. Never commit backend/.env.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/legal_playbook

# Voyage API key. Keep the real value only in ignored backend/.env.
VOYAGE_API_KEY=replace-with-your-rotated-voyage-key
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_EMBEDDING_DIMENSIONS=1024

# LLM configuration (OpenCode by default)
LLM_API_KEY=replace-with-your-rotated-opencode-key
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=kimi-k2.6

# App settings
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_STORAGE_PATH=storage/uploads
MAX_UPLOAD_BYTES=10485760
